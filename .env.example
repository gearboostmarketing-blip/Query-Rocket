# --- Server ---
DOMAIN=hub.yourdomain.com
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=hub.yourdomain.com

# --- Database (leave POSTGRES_* blank locally to use SQLite) ---
POSTGRES_DB=queryrocket
POSTGRES_USER=queryrocket
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Job queue ---
REDIS_URL=redis://redis:6379/0

# --- AI ---
ANTHROPIC_API_KEY=
# Model for understanding the business (quality matters)
AI_MODEL_PROFILE=claude-sonnet-5
# Model for classifying pages in bulk (speed and cost matter)
AI_MODEL_CLASSIFY=claude-haiku-4-5-20251001

# --- Crawler ---
CRAWL_MAX_PAGES=500
CRAWL_DELAY_SECONDS=0.5
CRAWL_INTERVAL_DAYS=7
# Render pages in a real browser (slower, sees JavaScript output)
CRAWL_RENDER_JS=False

# --- Google (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank on the server; it defaults to https://DOMAIN/google/callback/
GOOGLE_REDIRECT_URI=
# Days of history pulled the first time a site is linked
GOOGLE_BACKFILL_DAYS=120

# --- Fixes (Phase 3) ---
# Most new fix proposals per site per run (controls AI cost)
FIX_MAX_PER_RUN=40

# --- Autopilot and weekly email (Phase 5) ---
# Emergency stop: set True and restart to halt autopilot on every site
AUTOPILOT_PAUSED=False
# Who gets the Monday report (comma separated)
REPORT_EMAIL_TO=
DEFAULT_FROM_EMAIL=Query Rocket <reports@yourdomain.com>
# SMTP for sending the report (e.g. Google Workspace, Mailgun, Postmark). Blank = report is only logged.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
